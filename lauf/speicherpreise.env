# Jede gepushte Änderung an dieser Datei (Branch main) startet den Workflow "Speicherpreise sammeln".
# ANSTOSS zählt hoch, damit sich die Datei bei gleichen Einstellungen trotzdem ändert.
ANSTOSS=2
# MODUS=sammeln: neue Funde suchen; MODUS=auszuege: zu den vorhandenen Funden Originalauszüge ablegen
MODUS=auszuege
# nur Modus sammeln: Anzahl Suchabfragen (Brave, kostet Kontingent) und höchste Zahl gelesener Seiten
ABFRAGEN=10
SEITEN=150
