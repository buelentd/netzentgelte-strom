# Jede gepushte Änderung an dieser Datei (Branch main) startet den Workflow "Speicherpreise sammeln".
# ANSTOSS zählt hoch, damit sich die Datei bei gleichen Einstellungen trotzdem ändert.
ANSTOSS=1
# Anzahl Suchabfragen (Brave, kostet Kontingent) und höchste Zahl gelesener Seiten
ABFRAGEN=10
SEITEN=150
