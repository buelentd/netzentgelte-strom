# Jede gepushte Änderung an dieser Datei (Branch main) startet den Workflow "Speicherpreise sammeln".
# ANSTOSS zählt hoch, damit sich die Datei bei gleichen Einstellungen trotzdem ändert.
ANSTOSS=8
# MODUS: runde7 (Händler-Produktseiten: Gesamtpreis und kWh -> €/kWh), sammeln (Runde 1), runde3 (Originalquellen, die die Fundseiten nennen), runde4 (Verweislinks der Fundseiten), runde2 (Hersteller, Angebote, Preislisten, PDFs), auszuege (Originalauszüge), aufschlaege (Strompreis-Aufschläge)
MODUS=runde7
# Anzahl Suchabfragen (Brave, kostet Kontingent) und höchste Zahl gelesener Seiten/PDFs
ABFRAGEN=33
SEITEN=200
