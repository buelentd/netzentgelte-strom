# Jede gepushte Änderung an dieser Datei (Branch main) startet den Workflow "Netzentgelte Strom".
# Erlaubt sind nur diese Schlüssel; Werte nur Buchstaben, Ziffern, Komma, Unterstrich.
# ANSTOSS zählt hoch, damit sich die Datei bei gleichen Einstellungen trotzdem ändert.
ANSTOSS=25
JAHR=2026
LIMIT=
WORKER=16
WIEDERHOLEN=
LISTE_NEU=false
DIAGNOSE=true
# Höchstzahl Suchabfragen in diesem Lauf (Brave Search; Restguthaben ca. 190 Abfragen)
SUCHE_MAX=0
# Diese Nummern unabhängig vom Status neu bearbeiten (z. B. nach Korrekturen)
NEU_PRUEFEN=59,74,75,79,115,142,145,180,188,203,210,212,215,233,234,256,258,262,275,360,363,366,402,405,407,418,424,434,448,459,467,494,509,521,527,529,539,546,613,622,635,648,665,666,667,673,678,695,749,769,776,783,809
# Nur Suchtreffer prüfen (Brave-Suche), Websites nicht durchsuchen; Ergebnisse nur bei Verbesserung übernehmen
NUR_SUCHTREFFER=false
# Nur die schon geladenen Preisblätter neu auslesen, ohne Internet und ohne Suche (Minuten)
AUSLESEN=false
